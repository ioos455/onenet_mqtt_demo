#ifndef _ONENET_SECRETS_H_
#define _ONENET_SECRETS_H_

/*
 * 本文件存放所有敏感信息(产品ID、产品密钥、设备名称、WiFi账号密码)。
 *
 * 真正的配置放在同目录的 onenet_secrets.h 中，该文件已被 .gitignore 忽略，
 * 不会提交到 Git。首次编译时若 onenet_secrets.h 不存在，CMake 会自动用本模板
 * 生成一份，请把下面的占位内容替换成自己在 OneNET 平台和路由器上的真实信息。
 */

//OneNET 产品ID
#define ONENET_PRODUCT_ID               "YOUR_PRODUCT_ID"

//OneNET 产品密钥
#define ONENET_PRODUCT_ACCESS_KEY       "YOUR_PRODUCT_ACCESS_KEY"

//OneNET 设备名称
#define ONENET_DEVICE_NAME              "YOUR_DEVICE_NAME"

//WiFi 名称(SSID)
#define WIFI_SSID                       "YOUR_WIFI_SSID"

//WiFi 密码
#define WIFI_PASSWORD                   "YOUR_WIFI_PASSWORD"

#endif
